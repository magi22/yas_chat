# Modèle de fichier secrets pour Streamlit
# ─────────────────────────────────────────
# Utilisation locale :
#   1. Copiez ce fichier : cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   2. Renseignez votre clé API ci-dessous
#
# Déploiement Streamlit Cloud :
#   Collez le contenu (avec la vraie clé) dans :
#   App Settings → Secrets

GOOGLE_API_KEY = "votre_cle_api_gemini_ici"
